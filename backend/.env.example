# ==========================================
# NextCRM NestJS Backend Environment
# ==========================================

NODE_ENV=development
PORT=4000
APP_NAME=NextCRM

# Database: MongoDB connection with Prisma
DATABASE_URL="mongodb://root:example@localhost:27017/nextcrm?authSource=admin"

# Redis Cache & BullMQ Queue Infrastructure
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# JWT Authentication
JWT_SECRET="secure_jwt_production_secret_key_minimum_32_chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="secure_jwt_refresh_token_secret_minimum_32_chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:4200"
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Omnichannel Integrations
WHATSAPP_API_URL="https://graph.facebook.com/v20.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

META_MESSENGER_API_URL="https://graph.facebook.com/v20.0"
META_MESSENGER_PAGE_TOKEN=""
META_MESSENGER_VERIFY_TOKEN=""

# Email Provider (smtp, resend, emailjs)
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NextCRM <no-reply@nextcrm.local>"

# AI Provider (openai, gemini)
AI_PROVIDER="openai"
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# S3/MinIO Storage
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="nextcrm-media"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="us-east-1"
